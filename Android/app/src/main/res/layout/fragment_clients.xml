<?xml version="1.0" encoding="utf-8"?>
<!-- Onglet Clients (maquette 04) : points de livraison dans une ListView.
     Les points de départ sont ajoutés en pied de liste (pied_points_depart.xml)
     pour défiler avec elle sur les petits écrans. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp"
        android:text="@string/clients_intro"
        android:textColor="@color/texte_secondaire"
        android:textSize="13sp" />

    <ListView
        android:id="@+id/listeClients"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:divider="@color/separateur"
        android:dividerHeight="1dp" />
</LinearLayout>
