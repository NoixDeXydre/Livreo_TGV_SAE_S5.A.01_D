<?xml version="1.0" encoding="utf-8"?>
<!-- Un client de la liste : 3 TextView (nom, adresse, résumé) + bouton carte -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/blanc"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingTop="10dp"
    android:paddingEnd="4dp"
    android:paddingBottom="10dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/texteNom"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/texte"
            android:textSize="16sp"
            tools:text="Scierie Combes" />

        <TextView
            android:id="@+id/texteAdresse"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/texte_secondaire"
            android:textSize="14sp"
            tools:text="8 route du Moulin" />

        <TextView
            android:id="@+id/texteResume"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/texte_secondaire"
            android:textSize="13sp"
            tools:text="3 colis · 2 280 kg" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/boutonCarte"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@android:drawable/ic_menu_mapmode"
        app:tint="@color/brique"
        tools:ignore="ContentDescription" />
</LinearLayout>
