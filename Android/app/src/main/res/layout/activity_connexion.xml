<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/racine"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fond"
    android:orientation="vertical"
    tools:context=".ConnexionActivity">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="?attr/actionBarSize"
        android:background="@color/brique"
        android:elevation="4dp"
        android:theme="@style/ThemeOverlay.Material3.Dark.ActionBar"
        app:popupTheme="@style/ThemeOverlay.Material3.Light" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="40dp"
            android:paddingEnd="24dp"
            android:paddingBottom="24dp">

            <ImageView
                android:layout_width="88dp"
                android:layout_height="88dp"
                android:layout_gravity="center_horizontal"
                android:background="@drawable/fond_rond_icone"
                android:importantForAccessibility="no"
                android:padding="20dp"
                android:src="@drawable/ic_camion" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="12dp"
                android:text="@string/connexion_titre"
                android:textColor="@color/texte"
                android:textSize="24sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:labelFor="@id/champIdentifiant"
                android:text="@string/connexion_identifiant"
                android:textColor="@color/texte_secondaire"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/champIdentifiant"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:autofillHints="username"
                android:hint="@string/connexion_identifiant_hint"
                android:inputType="text"
                android:minHeight="48dp"
                android:textSize="16sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:labelFor="@id/champMotDePasse"
                android:text="@string/connexion_mdp"
                android:textColor="@color/texte_secondaire"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/champMotDePasse"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:autofillHints="password"
                android:hint="@string/connexion_mdp"
                android:inputType="textPassword"
                android:minHeight="48dp"
                android:textSize="16sp" />

            <CheckBox
                android:id="@+id/caseResterConnecte"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:checked="true"
                android:minHeight="48dp"
                android:text="@string/connexion_rester"
                android:textSize="16sp" />

            <Button
                android:id="@+id/boutonConnexion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/connexion_bouton" />

            <TextView
                android:id="@+id/texteStatut"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:drawablePadding="8dp"
                android:gravity="center_vertical"
                android:text="@string/statut_serveur_joignable"
                android:textColor="@color/texte_secondaire"
                android:textSize="14sp"
                app:drawableStartCompat="@drawable/point_en_ligne" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@drawable/fond_info"
                android:lineSpacingExtra="2sp"
                android:padding="12dp"
                android:text="@string/connexion_info"
                android:textColor="@color/info_texte"
                android:textSize="14sp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>