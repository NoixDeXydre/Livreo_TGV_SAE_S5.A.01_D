<?xml version="1.0" encoding="utf-8"?>
<!-- Un arrêt de la tournée : numéro, client + résumé, boutons monter / descendre -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="3dp"
    android:layout_marginBottom="3dp"
    app:cardBackgroundColor="@color/blanc"
    app:cardCornerRadius="8dp"
    app:cardElevation="2dp"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="60dp"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="4dp">

        <TextView
            android:id="@+id/texteNumero"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@drawable/fond_numero"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:textColor="@color/blanc"
            android:textSize="14sp"
            tools:text="1" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/texteNom"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/texte"
                android:textSize="15sp"
                tools:text="Scierie Combes" />

            <TextView
                android:id="@+id/texteResume"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/texte_secondaire"
                android:textSize="13sp"
                tools:text="3 colis · 2 280 kg" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/boutonMonter"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_monter"
            tools:ignore="ContentDescription" />

        <ImageButton
            android:id="@+id/boutonDescendre"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_descendre"
            tools:ignore="ContentDescription" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
