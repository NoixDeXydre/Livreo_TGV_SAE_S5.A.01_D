<?xml version="1.0" encoding="utf-8"?>
<!-- Onglet Optimisé (maquettes 08 et 08b) : point de départ, choix de l'algorithme, calcul.
     Les vues "hors ligne" (bandeau, bouton mode manuel) sont cachées par défaut. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Bandeau jaune, visible seulement hors ligne (maquette 08b) -->
    <TextView
        android:id="@+id/bandeauHorsLigne"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/alerte_fond"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp"
        android:text="@string/planif_bandeau_hors_ligne"
        android:textColor="@color/alerte_texte"
        android:textSize="14sp"
        android:visibility="gone" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:text="@string/planif_depart"
                android:textColor="@color/texte_secondaire"
                android:textSize="13sp" />

            <Spinner
                android:id="@+id/spinnerDepart"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:entries="@array/points_depart"
                android:minHeight="44dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:text="@string/bouchon_planif_taille"
                android:textColor="@color/texte_secondaire"
                android:textSize="14sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="sans-serif-medium"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:text="@string/planif_algorithme"
                android:textColor="@color/brique"
                android:textSize="14sp" />

            <!-- Chaque RadioButton est suivi d'un TextView pour sa difficulté -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:cardBackgroundColor="@color/blanc"
                app:cardCornerRadius="8dp"
                app:cardElevation="2dp"
                app:strokeWidth="0dp">

                <RadioGroup
                    android:id="@+id/groupeAlgorithmes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:checkedButton="@id/radioExacteEquipe"
                    android:paddingStart="8dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="10dp">

                    <RadioButton
                        android:id="@+id/radioExacteEquipe"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/algo_exacte_equipe"
                        android:textSize="15sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="32dp"
                        android:text="@string/algo_exacte_equipe_diff"
                        android:textColor="@color/texte_secondaire"
                        android:textSize="13sp" />

                    <RadioButton
                        android:id="@+id/radioExacteLib"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/algo_exacte_lib"
                        android:textSize="15sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="32dp"
                        android:text="@string/algo_exacte_lib_diff"
                        android:textColor="@color/texte_secondaire"
                        android:textSize="13sp" />

                    <RadioButton
                        android:id="@+id/radioApprochee"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/algo_approchee"
                        android:textSize="15sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="32dp"
                        android:text="@string/algo_approchee_diff"
                        android:textColor="@color/texte_secondaire"
                        android:textSize="13sp" />
                </RadioGroup>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/texteEnLigne"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:drawablePadding="8dp"
                android:gravity="center_vertical"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:text="@string/planif_en_ligne"
                android:textColor="@color/texte_secondaire"
                android:textSize="13sp"
                app:drawableStartCompat="@drawable/point_en_ligne" />
        </LinearLayout>
    </ScrollView>

    <!-- Barre du bas -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/blanc"
        android:elevation="8dp"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="16dp">

        <!-- Visible seulement hors ligne : bascule sur l'onglet Manuel -->
        <Button
            android:id="@+id/boutonModeManuel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:text="@string/planif_mode_manuel"
            android:visibility="gone" />

        <Button
            android:id="@+id/boutonLancer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/planif_lancer" />
    </LinearLayout>
</LinearLayout>
