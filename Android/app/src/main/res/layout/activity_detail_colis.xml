<?xml version="1.0" encoding="utf-8"?>
<!-- Écran 05 : détail d'un colis.
     Toolbar (retour) · ScrollView · 3 cartes : résumé, client, pièces (TableLayout).
     Vue seule : le contenu vient des chaînes "bouchon_..." de strings.xml. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fond"
    android:orientation="vertical"
    tools:context=".DetailColisActivity">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="?attr/actionBarSize"
        android:background="@color/brique"
        android:elevation="4dp"
        android:theme="@style/ThemeOverlay.Material3.Dark.ActionBar"
        app:popupTheme="@style/ThemeOverlay.Material3.Light" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingTop="16dp"
            android:paddingEnd="12dp"
            android:paddingBottom="16dp">

            <!-- Carte 1 : poids, position au chargement, commande -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/blanc"
                app:cardCornerRadius="8dp"
                app:cardElevation="2dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/detail_poids_total"
                            android:textColor="@color/texte_secondaire"
                            android:textSize="14sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/bouchon_detail_poids"
                            android:textColor="@color/texte"
                            android:textSize="28sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/detail_position"
                            android:textColor="@color/texte_secondaire"
                            android:textSize="14sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:text="@string/bouchon_detail_position"
                            android:textColor="@color/texte"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/detail_commande"
                            android:textColor="@color/texte_secondaire"
                            android:textSize="14sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:text="@string/bouchon_detail_commande"
                            android:textColor="@color/texte"
                            android:textSize="14sp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Carte 2 : client et bouton carte -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="@color/blanc"
                app:cardCornerRadius="8dp"
                app:cardElevation="2dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/detail_client"
                        android:textColor="@color/brique"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/bouchon_detail_client"
                        android:textColor="@color/texte"
                        android:textSize="18sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/bouchon_detail_adresse"
                        android:textColor="@color/texte_secondaire"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/bouchon_detail_contact"
                        android:textColor="@color/texte_secondaire"
                        android:textSize="14sp" />

                    <Button
                        style="@style/Bouton.Livreo.Tonal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/detail_voir_carte"
                        app:icon="@android:drawable/ic_menu_mapmode"
                        app:iconGravity="textStart" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Carte 3 : pièces emballées -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="@color/blanc"
                app:cardCornerRadius="8dp"
                app:cardElevation="2dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/detail_pieces"
                        android:textColor="@color/brique"
                        android:textSize="14sp" />

                    <!-- stretchColumns="1" : la désignation prend la place restante
                         showDividers="middle" : un trait entre chaque ligne -->
                    <TableLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:divider="@drawable/separateur_ligne"
                        android:showDividers="middle"
                        android:stretchColumns="1">

                        <!-- En-tête -->
                        <TableRow
                            android:paddingTop="8dp"
                            android:paddingBottom="8dp">

                            <TextView
                                android:fontFamily="sans-serif-medium"
                                android:paddingStart="0dp"
                                android:paddingEnd="8dp"
                                android:text="@string/detail_col_numero"
                                android:textColor="@color/texte_secondaire"
                                android:textSize="14sp" />

                            <TextView
                                android:fontFamily="sans-serif-medium"
                                android:paddingStart="8dp"
                                android:paddingEnd="8dp"
                                android:text="@string/detail_col_designation"
                                android:textColor="@color/texte_secondaire"
                                android:textSize="14sp" />

                            <TextView
                                android:fontFamily="sans-serif-medium"
                                android:gravity="end"
                                android:paddingStart="8dp"
                                android:paddingEnd="0dp"
                                android:text="@string/detail_col_poids"
                                android:textColor="@color/texte_secondaire"
                                android:textSize="14sp" />
                        </TableRow>

                        <TableRow
                            android:paddingTop="10dp"
                            android:paddingBottom="10dp">

                            <TextView
                                android:paddingStart="0dp"
                                android:paddingEnd="8dp"
                                android:text="@string/bouchon_piece1_numero"
                                android:textColor="@color/texte"
                                android:textSize="14sp" />

                            <TextView
                                android:paddingStart="8dp"
                                android:paddingEnd="8dp"
                                android:text="@string/bouchon_piece1_designation"
                                android:textColor="@color/texte"
                                android:textSize="14sp" />

                            <TextView
                                android:gravity="end"
                                android:paddingStart="8dp"
                                android:paddingEnd="0dp"
                                android:text="@string/bouchon_piece1_poids"
                                android:textColor="@color/texte"
                                android:textSize="14sp" />
                        </TableRow>

                        <TableRow
                            android:paddingTop="10dp"
                            android:paddingBottom="10dp">

                            <TextView
                                android:paddingStart="0dp"
                                android:paddingEnd="8dp"
                                android:text="@string/bouchon_piece2_numero"
                                android:textColor="@color/texte"
                                android:textSize="14sp" />

                            <TextView
                                android:paddingStart="8dp"
                                android:paddingEnd="8dp"
                                android:text="@string/bouchon_piece2_designation"
                                android:textColor="@color/texte"
                                android:textSize="14sp" />

                            <TextView
                                android:gravity="end"
                                android:paddingStart="8dp"
                                android:paddingEnd="0dp"
                                android:text="@string/bouchon_piece2_poids"
                                android:textColor="@color/texte"
                                android:textSize="14sp" />
                        </TableRow>

                        <TableRow
                            android:paddingTop="10dp"
                            android:paddingBottom="10dp">

                            <TextView
                                android:paddingStart="0dp"
                                android:paddingEnd="8dp"
                                android:text="@string/bouchon_piece3_numero"
                                android:textColor="@color/texte"
                                android:textSize="14sp" />

                            <TextView
                                android:paddingStart="8dp"
                                android:paddingEnd="8dp"
                                android:text="@string/bouchon_piece3_designation"
                                android:textColor="@color/texte"
                                android:textSize="14sp" />

                            <TextView
                                android:gravity="end"
                                android:paddingStart="8dp"
                                android:paddingEnd="0dp"
                                android:text="@string/bouchon_piece3_poids"
                                android:textColor="@color/texte"
                                android:textSize="14sp" />
                        </TableRow>
                    </TableLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
